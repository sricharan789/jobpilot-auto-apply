# Required
ANTHROPIC_API_KEY=sk-ant-...
DASHBOARD_PASSWORD=choose-a-long-password
PUBLIC_URL=https://your-app.fly.dev

# Safety: forms are filled but never submitted until you set this to false
DRY_RUN=true
MAX_APPLICATIONS_PER_DAY=15

# Optional
DASHBOARD_USER=admin
CLAUDE_MODEL=claude-sonnet-5-5
DISCOVER_EVERY_HOURS=6
MAX_SCORES_PER_RUN=60
DATA_DIR=/data

# Email digest (Gmail: create an App Password at myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
NOTIFY_EMAIL=you@gmail.com

# Phone push: install the ntfy app and subscribe to this (hard-to-guess) topic
NTFY_TOPIC=

# Adzuna job search API (free key at developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
